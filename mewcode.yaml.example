# 复制为 mewcode.yaml 后填写。真实 key 永远不要提交进版本库。
# 一份文件 = 当前激活的后端。`protocol` 决定用哪个客户端。

# --- Anthropic（Claude） ---
protocol: anthropic
model: claude-sonnet-4-5
base_url: ""            # 留空 => https://api.anthropic.com
api_key: 你的_anthropic_key
# max_output_tokens: 1024
thinking: true          # 开启 Claude 的 extended thinking
thinking_budget: 1024
prompt_caching: true    # ch05：开启 prompt 缓存(稳定 system+工具前缀被缓存，省重复 token)

# --- ch06：安全检查(三段都可省略，省略即"默认档 + 只允许项目根 + 内置黑名单") ---
permission_mode: default   # strict(没显式放行就问) / default(沙箱内放行) / permissive(只留黑名单)
sandbox_roots: []          # 允许读写的目录列表；留空 = 只允许启动时所在的项目根
extra_deny_patterns: []    # 追加的危险命令黑名单(正则)；只能加严，删不掉内置的那些
# 例：sandbox_roots: ["D:/Project/my_code", "D:/shared"]
# 例：extra_deny_patterns: ["\\bgit\\s+push\\s+--force\\b"]

# --- 或 OpenAI ---
# protocol: openai
# model: gpt-4o-mini
# base_url: ""          # 留空 => https://api.openai.com/v1
# api_key: 你的_openai_key
# thinking: false
